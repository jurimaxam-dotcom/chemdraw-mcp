{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": false
  },
  "description": "Generate a 3D conformer shown as an interactive, rotatable model.\n\nEmbeds the molecule in 3D (ETKDGv3 + force-field optimization, explicit\nhydrogens) and opens a drag-to-rotate ball-and-stick viewer in the chat\npanel. Also writes an SDF file for molecular modelling tools.\n\nUse this when the user asks about 3D structure, molecular geometry\n(tetrahedral, planar...), conformation or spatial arrangement.\n\nNot this tool for: a flat 2D structure drawing, a Fischer/Haworth\nprojection or a chair drawing — use generate_molecule. Nor for a\nprotein, enzyme or antibody, also its 3D structure — use generate_protein_or_antibody\n(its panel rotates); its function or EC number — use lookup, \"biochem\".\n\nIMPORTANT: Pass English/IUPAC names or SMILES; use label for the\nlocalized display name.\n\nArgs:\n    name_or_smiles: English/IUPAC compound name or SMILES string.\n    label: Optional display name (localizable).",
  "inputSchema": {
    "properties": {
      "label": {
        "default": "",
        "title": "Label",
        "type": "string"
      },
      "name_or_smiles": {
        "title": "Name Or Smiles",
        "type": "string"
      }
    },
    "required": [
      "name_or_smiles"
    ],
    "title": "generate_3dArguments",
    "type": "object"
  },
  "name": "generate_3d",
  "outputSchema": {
    "$defs": {
      "ProteinView": {
        "description": "Protein cartoon for the panel (backbone N/Cα/O, secondary structure, bound groups).",
        "properties": {
          "chains": {
            "default": [],
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Chains",
            "type": "array"
          },
          "citation": {
            "default": "",
            "title": "Citation",
            "type": "string"
          },
          "colorBy": {
            "default": "ss",
            "title": "Colorby",
            "type": "string"
          },
          "identifier": {
            "default": "",
            "title": "Identifier",
            "type": "string"
          },
          "ligands": {
            "default": [],
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Ligands",
            "type": "array"
          },
          "plddtMean": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Plddtmean"
          },
          "scheme": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Scheme"
          },
          "source": {
            "default": "",
            "title": "Source",
            "type": "string"
          },
          "ssSource": {
            "default": "deposited",
            "title": "Sssource",
            "type": "string"
          },
          "subtitle": {
            "default": "",
            "title": "Subtitle",
            "type": "string"
          },
          "title": {
            "default": "",
            "title": "Title",
            "type": "string"
          }
        },
        "title": "ProteinView",
        "type": "object"
      }
    },
    "description": "3D conformer for the interactive panel viewer (ball-and-stick).",
    "properties": {
      "atoms": {
        "default": [],
        "items": {
          "additionalProperties": true,
          "type": "object"
        },
        "title": "Atoms",
        "type": "array"
      },
      "bonds": {
        "default": [],
        "items": {
          "additionalProperties": true,
          "type": "object"
