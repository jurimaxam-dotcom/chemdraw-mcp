{
  "description": "Show a compound's data sheet as a panel: structure plus grouped facts.\n\n    Aggregates PubChem properties and GHS safety into one panel with the\n    drawn structure beside them, grouped by source. Use it when the request\n    asks for a data sheet, an overview or \"all the data\" on a substance.\nOne call covers the properties and GHS data it lists; do not follow it\nwith predict_spectrum or repeat those facts via lookup unless asked.\n\n    Not this tool for: a bare compound name with no data asked for — that\n    means show the substance, use generate_molecule. Nor for a single fact in\n    text form, or the topics this does not cover (physical constants,\n    biochem, pathways) — that is lookup.\n\n    IMPORTANT: Always pass English or IUPAC compound names, never localized\n    names ('Aspirin' not 'Acetylsalicylsäure'). SMILES are always safe.\n\n    Args:\n        name: English/IUPAC compound name or SMILES (e.g. 'Aspirin').\n    ",
  "inputSchema": {
    "properties": {
      "name": {
        "title": "Name",
        "type": "string"
      }
    },
    "required": [
      "name"
    ],
    "title": "lookup_molecule_dataArguments",
    "type": "object"
  },
  "name": "lookup_molecule_data",
  "outputSchema": {
    "$defs": {
      "AtomData": {
        "properties": {
          "charge": {
            "default": 0,
            "title": "Charge",
            "type": "integer"
          },
          "el": {
            "title": "El",
            "type": "string"
          },
          "hCount": {
            "default": 0,
            "title": "Hcount",
            "type": "integer"
          },
          "idx": {
            "title": "Idx",
            "type": "integer"
          },
          "x": {
            "title": "X",
            "type": "number"
          },
          "y": {
            "title": "Y",
            "type": "number"
          }
        },
        "required": [
          "idx",
          "el",
          "x",
          "y"
        ],
        "title": "AtomData",
        "type": "object"
      },
      "DatabaseRow": {
        "properties": {
          "key": {
            "title": "Key",
            "type": "string"
          },
          "val": {
            "title": "Val",
            "type": "string"
          }
        },
        "required": [
          "key",
          "val"
