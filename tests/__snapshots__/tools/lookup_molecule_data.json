              "$ref": "#/$defs/GhsGroup"
            },
            "title": "Groups",
            "type": "array"
          },
          "note": {
            "default": "",
            "title": "Note",
            "type": "string"
          },
          "rows": {
            "default": [],
            "items": {
              "$ref": "#/$defs/DatabaseRow"
            },
            "title": "Rows",
            "type": "array"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "status": {
            "default": "",
            "title": "Status",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "type",
          "source",
          "url"
        ],
        "title": "DatabaseSource",
        "type": "object"
      },
      "FunctionalGroup": {
        "properties": {
          "atomIndices": {
            "default": [],
