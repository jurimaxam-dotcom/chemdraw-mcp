              "type": "integer"
            },
            "title": "Atomindices",
            "type": "array"
          },
          "color": {
            "default": "#999999",
            "title": "Color",
            "type": "string"
          },
          "count": {
            "default": 1,
            "title": "Count",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "FunctionalGroup",
