{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": false
  },
  "description": "Generate a reaction scheme (educts → products) as image files.\n\nWrites the scheme as PNG and/or SVG (default both) to the output folder —\nno ChemDraw required. Conditions appear above the arrow, conditions_below\nunder it.\n\nUse this when the user describes a chemical reaction with educts and\nproducts — including in conversation: \"how does the esterification of\nacetic acid with ethanol work?\" asks for this scheme, not for prose.\nDraw it and explain alongside.\n\nNot this tool for: the step-by-step course with electron-flow arrows —\nthat is generate_mechanism. Also not for many products of one reaction\nwith yields (generate_scope_table).\n\nCurved-arrow mechanisms are drawn only for SN1, SN2 and Fischer\nesterification (generate_mechanism). For any other mechanism, such as\nDiels–Alder, draw the net scheme here and tell the user that the arrow\nmechanism is not drawn.\n\nAlways pass English or IUPAC names ('Aspirin', not\n'Acetylsalicylsäure'); SMILES are always safe.\n\nArgs:\n    reactants: English/IUPAC reactant names or SMILES.\n    products: English/IUPAC product names or SMILES.\n    conditions: Text above the arrow (e.g. 'H2SO4, 0-5 °C'); formula\n        digits are subscripted.\n    conditions_below: Text under the arrow (e.g. 'reflux, 2 h').\n    arrow: \"forward\" (→), \"equilibrium\" (⇌) or \"retro\" (⇒, target as\n        reactants, precursors as products).\n    name: Display name (can be localized).\n    formats: Any of \"png\", \"svg\", \"cdxml\" (default png + svg); \"cdxml\"\n        only for editing in ChemDraw.\n    abbreviate_groups: True draws common substituents as labels (Ph,\n        OAc, tBu …); the CDXML keeps full structures.\n    render_style: \"\" standard · \"compact\" small print · \"presentation\"\n        slides · \"grayscale\" b/w palette.\n    coefficients: One integer per species, reactants then products\n        ([2, 1, 2] draws 2 H2 + O2 → 2 H2O). Set only when the user asks\n        for a balanced equation; otherwise draw as given — the panel's\n        \"Apply coefficients\" button sets them.",
  "inputSchema": {
    "properties": {
      "abbreviate_groups": {
        "default": false,
        "title": "Abbreviate Groups",
        "type": "boolean"
      },
      "arrow": {
        "default": "forward",
        "enum": [
          "forward",
          "equilibrium",
          "retro"
        ],
        "title": "Arrow",
        "type": "string"
      },
      "coefficients": {
        "anyOf": [
          {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Coefficients"
      },
      "conditions": {
        "default": "",
        "title": "Conditions",
        "type": "string"
      },
      "conditions_below": {
        "default": "",
        "title": "Conditions Below",
        "type": "string"
      },
      "formats": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Formats"
      },
      "name": {
        "default": "",
        "title": "Name",
        "type": "string"
      },
      "products": {
        "items": {
          "type": "string"
        },
        "title": "Products",
        "type": "array"
      },
      "reactants": {
        "items": {
          "type": "string"
        },
        "title": "Reactants",
        "type": "array"
      },
      "render_style": {
        "default": "",
        "title": "Render Style",
        "type": "string"
      }
    },
    "required": [
      "reactants",
      "products"
    ],
    "title": "generate_reactionArguments",
    "type": "object"
  },
  "name": "generate_reaction",
  "outputSchema": {
    "$defs": {
      "MolEntry": {
        "properties": {
          "coefficient": {
            "default": 1,
            "title": "Coefficient",
            "type": "integer"
          },
          "name": {
            "default": "",
            "title": "Name",
            "type": "string"
          },
          "svg": {
            "default": "",
            "title": "Svg",
            "type": "string"
          }
        },
        "title": "MolEntry",
        "type": "object"
      },
      "ReactionBalance": {
        "description": "Atom and charge balance of the equation as drawn (all coefficients 1).",
        "properties": {
          "balanced": {
            "title": "Balanced",
            "type": "boolean"
          },
          "chargeDifference": {
            "default": 0,
            "title": "Chargedifference",
            "type": "integer"
          },
          "difference": {
            "additionalProperties": {
              "type": "integer"
            },
            "default": {},
            "title": "Difference",
            "type": "object"
          },
          "formulas": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Formulas",
            "type": "array"
          },
          "note": {
            "default": "",
            "title": "Note",
            "type": "string"
          },
          "suggestedCoefficients": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Suggestedcoefficients"
          },
          "suggestedEquation": {
            "default": "",
            "title": "Suggestedequation",
            "type": "string"
          },
          "summary": {
            "default": "",
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "balanced"
        ],
        "title": "ReactionBalance",
        "type": "object"
      }
    },
    "properties": {
      "arrow": {
        "default": "forward",
        "title": "Arrow",
        "type": "string"
      },
      "balance": {
        "anyOf": [
          {
            "$ref": "#/$defs/ReactionBalance"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "cdxml_path": {
        "default": "",
        "title": "Cdxml Path",
        "type": "string"
      },
      "coefficients": {
        "default": [],
        "items": {
          "type": "integer"
        },
        "title": "Coefficients",
        "type": "array"
      },
      "conditions": {
        "default": "",
        "title": "Conditions",
        "type": "string"
      },
      "conditions_below": {
        "default": "",
        "title": "Conditions Below",
        "type": "string"
      },
      "files": {
        "additionalProperties": {
          "type": "string"
        },
        "default": {},
        "title": "Files",
        "type": "object"
      },
      "name": {
        "default": "",
        "title": "Name",
        "type": "string"
      },
      "products": {
        "default": [],
        "items": {
          "$ref": "#/$defs/MolEntry"
        },
        "title": "Products",
        "type": "array"
      },
      "reactants": {
        "default": [],
        "items": {
          "$ref": "#/$defs/MolEntry"
        },
        "title": "Reactants",
        "type": "array"
      },
      "request": {
        "additionalProperties": true,
        "default": {},
        "title": "Request",
        "type": "object"
      },
      "type": {
        "default": "reaction",
        "title": "Type",
        "type": "string"
      }
    },
    "title": "ReactionPayload",
    "type": "object"
  },
  "title": "Draw a reaction scheme"
}
