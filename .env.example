# ChemDraw MCP Server Configuration for Mistral AI Vibe
#
# Copy this file to .env and fill in the values, or set the environment variables
# directly in your shell.
#
# Required for authentication (MANDATORY for Vibe)
# -------------------------------------------
CHEMDRAW_SECRET_KEY=your-secret-key-here

# Optional: Comma-separated list of API keys
# If not set, only JWT tokens will work for authentication
CHEMDRAW_API_KEYS=api-key-1,api-key-2,api-key-3

# Optional: Token expiration time in minutes (default: 30)
CHEMDRAW_TOKEN_EXPIRE_MINUTES=30

# Optional: Output directory for generated files (default: ~/ChemDraw-Output)
CHEMDRAW_OUTPUT_DIR=/path/to/output

# Optional: Vault path for local knowledge base (default: ~/.chemdraw-mcp)
CHEMDRAW_VAULT_PATH=/path/to/vault

# =============================================================================
# How to Generate a Secret Key
# =============================================================================
# Run this command to generate a secure 32-byte hex key:
#   openssl rand -hex 32
#
# Example:
#   CHEMDRAW_SECRET_KEY=5f4dcc3b5aa765d61d8327deb882cf99

# =============================================================================
# How to Use with Vibe
# =============================================================================
#
# 1. Set the environment variables:
#    export CHEMDRAW_SECRET_KEY=$(openssl rand -hex 32)
#    export CHEMDRAW_API_KEYS="my-api-key-1,my-api-key-2"
#
# 2. Configure Vibe (vibe.config.yaml or similar):
#    mcpServers:
#      chemdraw:
#        command: uv
#        args: [--directory, /path/to/chemdraw-mcp, run, chemdraw-tool-server]
#        env:
#          CHEMDRAW_SECRET_KEY: "${CHEMDRAW_SECRET_KEY}"
#          CHEMDRAW_API_KEYS: "${CHEMDRAW_API_KEYS}"
#
# 3. Restart Vibe
#
# 4. Create a token for authentication:
#    create_auth_token(subject="your-user-id", role="user")
#
# 5. Use the token in your requests:
#    Authorization: Bearer <your-token>
#
# Or use an API key directly:
#    Authorization: Bearer <your-api-key>
#
# =============================================================================
# Authentication Flow
# =============================================================================
#
# 1. All tools require authentication (except auth management tools)
# 2. Two authentication methods are supported:
#    - JWT tokens (recommended for users)
#    - API keys (recommended for services)
# 3. Tokens expire after CHEMDRAW_TOKEN_EXPIRE_MINUTES (default: 30 min)
# 4. Use create_auth_token() to generate new tokens
# 5. Use add_api_key() to add new API keys
#
# =============================================================================
